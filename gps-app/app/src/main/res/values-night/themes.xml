<?xml version="1.0" encoding="utf-8"?>
<!-- Tryb ciemny: nocny parking. Karta „Twoje auto” zostaje asfaltowa, tło ciemnieje. -->
<resources>
    <color name="primary">#86ADEB</color>
    <color name="primary_dark">#A9C5F2</color>
    <color name="on_primary">#0D1E36</color>
    <color name="primary_soft">#22324A</color>
    <color name="background">#14171B</color>
    <color name="card">#1E2227</color>
    <color name="line">#30363D</color>
    <color name="text_primary">#E7E9EB</color>
    <color name="text_secondary">#9BA3AC</color>
    <color name="ok">#6FCF97</color>
    <color name="warn">#F2B26A</color>
    <color name="warn_soft">#3A2C1B</color>
    <color name="error">#F0897D</color>

    <color name="asphalt">#262B31</color>
    <color name="asphalt_raised">#323840</color>
    <color name="on_asphalt_line">#444B54</color>

    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/background</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>
