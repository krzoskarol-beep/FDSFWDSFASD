<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/primary_dark"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Status -->
        <LinearLayout style="@style/Card">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_waiting"
                android:textColor="@color/warn"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/actionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Współrzędne -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Label"
                android:layout_marginTop="0dp"
                android:text="@string/latitude" />

            <TextView
                android:id="@+id/latitude"
                style="@style/BigValue"
                android:text="—" />

            <TextView
                android:id="@+id/latitudeDms"
                style="@style/SmallValue"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <TextView
                style="@style/Label"
                android:text="@string/longitude" />

            <TextView
                android:id="@+id/longitude"
                style="@style/BigValue"
                android:text="—" />

            <TextView
                android:id="@+id/longitudeDms"
                style="@style/SmallValue"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMaps"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:text="@string/open_maps" />

                <Button
                    android:id="@+id/btnCopy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/copy" />

                <Button
                    android:id="@+id/btnShare"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.1"
                    android:text="@string/share" />
            </LinearLayout>
        </LinearLayout>

        <!-- Szczegóły -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Label"
                android:layout_marginTop="0dp"
                android:text="@string/accuracy" />

            <TextView
                android:id="@+id/accuracy"
                style="@style/SmallValue"
                android:text="—" />

            <TextView
                style="@style/Label"
                android:text="@string/altitude" />

            <TextView
                android:id="@+id/altitude"
                style="@style/SmallValue"
                android:text="—" />

            <TextView
                style="@style/Label"
                android:text="@string/speed" />

            <TextView
                android:id="@+id/speed"
                style="@style/SmallValue"
                android:text="—" />

            <TextView
                style="@style/Label"
                android:text="@string/bearing" />

            <TextView
                android:id="@+id/bearing"
                style="@style/SmallValue"
                android:text="—" />

            <TextView
                style="@style/Label"
                android:text="@string/satellites" />

            <TextView
                android:id="@+id/satellites"
                style="@style/SmallValue"
                android:text="—" />

            <TextView
                style="@style/Label"
                android:text="@string/source" />

            <TextView
                android:id="@+id/provider"
                style="@style/SmallValue"
                android:text="—" />

            <TextView
                style="@style/Label"
                android:text="@string/fix_time" />

            <TextView
                android:id="@+id/fixTime"
                style="@style/SmallValue"
                android:text="—" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
