<?xml version="1.0" encoding="utf-8"?>
<!--
  Jeden przewijany ekran z kartami. Ponad 80 widoków (TooManyViews) to świadomy wybór:
  wszystko jest statyczne i lekkie, a podział na fragmenty tylko skomplikowałby kod.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    tools:ignore="TooManyViews"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Nagłówek: znak P i nazwa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/p_badge"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="P"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Text"
                android:layout_width="0dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/header_title"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Stan GPS -->
        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/pill"
            android:drawableStart="@drawable/status_dot"
            android:drawablePadding="10dp"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/status_waiting"
            android:textColor="@color/warn"
            android:textSize="15sp" />

        <Button
            android:id="@+id/actionButton"
            style="@style/Btn.Filled"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <!-- Twoje auto: jedyny mocny element ekranu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/hero"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/Text.OnAsphalt.Soft"
                android:text="@string/parking_title"
                android:textSize="15sp" />

            <!-- Brak zapisanego miejsca -->
            <LinearLayout
                android:id="@+id/parkingEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.OnAsphalt"
                    android:layout_marginTop="10dp"
                    android:text="@string/parking_empty"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/btnSaveParking"
                    style="@style/Btn.Lane"
                    android:layout_width="match_parent"
                    android:layout_marginTop="18dp"
                    android:minHeight="56dp"
                    android:text="@string/parking_save" />
            </LinearLayout>

            <!-- Zapisane miejsce -->
            <LinearLayout
                android:id="@+id/parkingSaved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <pl.gps.pozycja.ArrowView
                    android:id="@+id/parkingArrow"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/parkingDistance"
                    style="@style/Text.OnAsphalt"
                    android:layout_marginTop="14dp"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:text="—"
                    android:textSize="46sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/parkingDirection"
                    style="@style/Text.OnAsphalt"
                    android:gravity="center"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/parkingCompassHint"
                    style="@style/Text.OnAsphalt.Soft"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/lane_line"
                    android:layerType="software" />

                <TextView
                    android:id="@+id/parkingAddress"
                    style="@style/Text.OnAsphalt"
                    android:textIsSelectable="true"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/parkingNote"
                    style="@style/Text.OnAsphalt"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/lane_yellow"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/parkingSavedAt"
                    style="@style/Text.OnAsphalt.Soft"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/parkingSavedAccuracy"
                    style="@style/Text.OnAsphalt.Soft"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnNavigate"
                    style="@style/Btn.Lane"
                    android:layout_width="match_parent"
                    android:layout_marginTop="18dp"
                    android:minHeight="56dp"
                    android:text="@string/parking_navigate" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSaveHere"
                        style="@style/Btn.OnAsphalt"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/parking_save_here" />

                    <Button
                        android:id="@+id/btnDeleteParking"
                        style="@style/Btn.OnAsphalt"
                        android:layout_width="0dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/parking_delete" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Twoja pozycja -->
        <TextView
            style="@style/Text.Title"
            android:text="@string/position_title" />

        <LinearLayout style="@style/Surface">

            <TextView
                style="@style/Text.Label"
                android:text="@string/latitude" />

            <TextView
                android:id="@+id/latitude"
                style="@style/Text.Coordinate"
                android:text="—" />

            <TextView
                android:id="@+id/latitudeDms"
                style="@style/Text.Secondary" />

            <TextView
                style="@style/Text.Label"
                android:layout_marginTop="14dp"
                android:text="@string/longitude" />

            <TextView
                android:id="@+id/longitude"
                style="@style/Text.Coordinate"
                android:text="—" />

            <TextView
                android:id="@+id/longitudeDms"
                style="@style/Text.Secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMaps"
                    style="@style/Btn.Tonal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/btn_map" />

                <Button
                    android:id="@+id/btnCopy"
                    style="@style/Btn.Outlined"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/copy" />

                <Button
                    android:id="@+id/btnShare"
                    style="@style/Btn.Outlined"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.25"
                    android:text="@string/share" />
            </LinearLayout>
        </LinearLayout>

        <!-- Szczegóły pomiaru: kafelki w dwóch kolumnach -->
        <LinearLayout
            style="@style/Surface"
            android:layout_marginTop="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView style="@style/Text.Label" android:text="@string/accuracy" />
                    <TextView android:id="@+id/accuracy" style="@style/Text.Value" android:text="—" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView style="@style/Text.Label" android:text="@string/altitude" />
                    <TextView android:id="@+id/altitude" style="@style/Text.Value" android:text="—" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView style="@style/Text.Label" android:text="@string/speed" />
                    <TextView android:id="@+id/speed" style="@style/Text.Value" android:text="—" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView style="@style/Text.Label" android:text="@string/bearing" />
                    <TextView android:id="@+id/bearing" style="@style/Text.Value" android:text="—" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView style="@style/Text.Label" android:text="@string/satellites" />
                    <TextView android:id="@+id/satellites" style="@style/Text.Value" android:text="—" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView style="@style/Text.Label" android:text="@string/source" />
                    <TextView android:id="@+id/provider" style="@style/Text.Value" android:text="—" />
                </LinearLayout>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView style="@style/Text.Label" android:text="@string/fix_time" />
                <TextView android:id="@+id/fixTime" style="@style/Text.Value" android:text="—" />
            </LinearLayout>
        </LinearLayout>

        <!-- Automatyczny zapis -->
        <TextView
            style="@style/Text.Title"
            android:text="@string/auto_title" />

        <LinearLayout style="@style/Surface">

            <Switch
                android:id="@+id/autoSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/auto_switch"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/autoStatus"
                style="@style/Text.Secondary"
                android:layout_marginTop="4dp"
                android:text="@string/auto_desc" />

            <LinearLayout
                android:id="@+id/autoBatteryBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/banner_warn"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/autoBatteryHint"
                    style="@style/Text"
                    android:text="@string/auto_battery_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/autoBatteryButton"
                    style="@style/Btn.Filled"
                    android:layout_marginTop="10dp"
                    android:text="@string/auto_battery_button" />
            </LinearLayout>
        </LinearLayout>

        <!-- Wygląd: przełącznik segmentowy -->
        <TextView
            style="@style/Text.Title"
            android:text="@string/theme_title" />

        <RadioGroup
            android:id="@+id/themeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/segment_bg"
            android:orientation="horizontal"
            android:padding="4dp">

            <RadioButton
                android:id="@+id/themeSystem"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/segment_item"
                android:button="@null"
                android:gravity="center"
                android:text="@string/theme_system"
                android:textColor="@color/segment_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/themeLight"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/segment_item"
                android:button="@null"
                android:gravity="center"
                android:text="@string/theme_light"
                android:textColor="@color/segment_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/themeDark"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/segment_item"
                android:button="@null"
                android:gravity="center"
                android:text="@string/theme_dark"
                android:textColor="@color/segment_text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RadioGroup>

        <!-- Więcej -->
        <LinearLayout
            style="@style/Surface"
            android:layout_marginTop="28dp"
            android:padding="0dp">

            <Button
                android:id="@+id/btnHistory"
                style="@style/Btn.Row"
                android:text="@string/history_title" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="18dp"
                android:background="@color/line" />

            <Button
                android:id="@+id/btnDiagnostics"
                style="@style/Btn.Row"
                android:text="@string/diag_title" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
