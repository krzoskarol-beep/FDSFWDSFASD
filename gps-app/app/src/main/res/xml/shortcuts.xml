    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_parking"
        android:shortcutId="save_parking"
        android:shortcutLongLabel="@string/shortcut_save_long"
        android:shortcutShortLabel="@string/shortcut_save_short">
        <intent
            android:action="pl.gps.pozycja.SAVE_PARKING"
            android:targetClass="pl.gps.pozycja.MainActivity"
            android:targetPackage="pl.gps.pozycja" />
    </shortcut>
</shortcuts>
