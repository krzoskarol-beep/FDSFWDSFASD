<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Konsola audio: ciemne tło, ciepły bursztyn jak diody sprzętu studyjnego. -->
    <color name="bg">#0F1113</color>
    <color name="panel">#181B1F</color>
    <color name="panel_raised">#21252A</color>
    <color name="line">#2E333A</color>
    <color name="text">#ECEEF0</color>
    <color name="text_dim">#9198A1</color>
    <color name="accent">#F2B134</color>
    <color name="on_accent">#1A1205</color>
    <color name="fader_track">#2A2F35</color>

    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
    </style>

    <!-- Teksty -->
    <style name="Text">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Text.Title">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Hero">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Powierzchnie -->
    <style name="Panel">
        <item name="android:background">@drawable/panel_bg</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
    </style>

    <!-- Przyciski -->
    <style name="Btn" parent="android:Widget.Material.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Btn.Outlined">
        <item name="android:background">@drawable/btn_outlined</item>
        <item name="android:textColor">@color/text</item>
    </style>
</resources>
