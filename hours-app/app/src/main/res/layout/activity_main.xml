<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Nagłówek i stawka -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Hero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/header_sub"
                    android:textColor="@color/ink_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/rateBtn"
                style="@style/Btn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minHeight="40dp"
                android:background="@drawable/chip_bg"
                android:contentDescription="@string/settings"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/ink" />
        </LinearLayout>

        <!-- Zegar: Clock In / Clock Out -->
        <LinearLayout
            style="@style/Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:paddingTop="22dp">

            <TextView
                android:id="@+id/status"
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_dim"
                android:text="@string/status_off" />

            <TextView
                android:id="@+id/timer"
                style="@style/Text.Num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ink"
                android:textSize="52sp"
                android:text="00:00:00" />

            <TextView
                android:id="@+id/earned"
                style="@style/Text.Num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/green"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/earnedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/earned_label"
                android:textColor="@color/ink_dim"
                android:textSize="12sp" />

            <Button
                android:id="@+id/clockBtn"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/btn_in"
                android:textColor="@color/on_color"
                android:textSize="22sp"
                android:text="@string/clock_in" />
        </LinearLayout>

        <!-- Tydzień: nawigacja i podsumowanie -->
        <LinearLayout
            style="@style/Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/prevWeek"
                    style="@style/Btn.Ghost"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/prev_week"
                    android:textSize="22sp"
                    android:text="‹" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/week_title" />

                    <TextView
                        android:id="@+id/weekLabel"
                        style="@style/Text.Num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ink"
                        android:textSize="16sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/nextWeek"
                    style="@style/Btn.Ghost"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/next_week"
                    android:textSize="22sp"
                    android:text="›" />
            </LinearLayout>

            <TextView
                android:id="@+id/thisWeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/row_bg"
                android:gravity="center"
                android:minHeight="40dp"
                android:text="@string/this_week"
                android:textColor="@color/green"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hours_label" />

                    <TextView
                        android:id="@+id/weekHours"
                        style="@style/Text.Num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/ink"
                        android:textSize="30sp" />

                    <TextView
                        android:id="@+id/weekHoursDec"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ink_dim"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pay_label" />

                    <TextView
                        android:id="@+id/weekPay"
                        style="@style/Text.Num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/green"
                        android:textSize="30sp" />

                    <TextView
                        android:id="@+id/weekDays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ink_dim"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Wpisy tygodnia -->
        <LinearLayout
            style="@style/Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/entries_title" />

            <TextView
                android:id="@+id/editHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/tap_to_edit"
                android:textColor="@color/ink_dim"
                android:textSize="12sp" />

            <!-- Po usunięciu: krótka informacja z możliwością cofnięcia. -->
            <LinearLayout
                android:id="@+id/undoBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/chip_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/undoText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/undoBtn"
                    style="@style/Btn"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/row_bg"
                    android:text="@string/undo"
                    android:textColor="@color/green" />
            </LinearLayout>

            <TextView
                android:id="@+id/emptyMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/no_entries"
                android:textColor="@color/ink_dim"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/entryList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/addEntry"
                style="@style/Btn.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="8dp"
                android:text="@string/add_entry" />
        </LinearLayout>

        <Button
            android:id="@+id/reportBtn"
            style="@style/Btn.Dark"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="@string/report" />
    </LinearLayout>
</ScrollView>
