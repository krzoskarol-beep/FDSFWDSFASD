<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView style="@style/Text.Title" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="@string/date" />
    <Button android:id="@+id/dateBtn" style="@style/Btn.Ghost"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:layout_marginBottom="12dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:baselineAligned="false" android:orientation="horizontal">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="6dp" android:orientation="vertical">
            <TextView style="@style/Text.Title" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/start" />
            <Button android:id="@+id/startBtn" style="@style/Btn.Ghost"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:fontFeatureSettings="tnum" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical">
            <TextView style="@style/Text.Title" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/end" />
            <Button android:id="@+id/endBtn" style="@style/Btn.Ghost"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:fontFeatureSettings="tnum" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/adjustLabel" style="@style/Text.Title" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="14dp"
        android:text="@string/adjust_label" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:orientation="horizontal">
        <Button android:id="@+id/minus60" style="@style/Btn.Ghost.Small" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:text="@string/minus_60" />
        <Button android:id="@+id/minus15" style="@style/Btn.Ghost.Small" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:text="@string/minus_15" />
        <Button android:id="@+id/plus15" style="@style/Btn.Ghost.Small" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:text="@string/plus_15" />
        <Button android:id="@+id/plus60" style="@style/Btn.Ghost.Small" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/plus_60" />
    </LinearLayout>

    <TextView android:id="@+id/summary" style="@style/Text.Num"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:textColor="@color/ink" android:textSize="16sp" />

    <TextView android:id="@+id/hint" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textColor="@color/ink_dim" android:textSize="13sp" android:visibility="gone" />

    <TextView android:id="@+id/error" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:textColor="@color/red" android:textSize="14sp" android:visibility="gone" />
</LinearLayout>
